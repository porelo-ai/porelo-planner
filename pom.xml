<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.fuin.porelo</groupId>
        <artifactId>porelo-parent</artifactId>
        <version>0.2.2-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>org.fuin.porelo</groupId>
    <artifactId>porelo-planner</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Porelo Planner</name>
    <description>Serves a project's stories and issues to the Porelo window over REST</description>

    <!-- Without the inherit.append.path attributes Maven appends each child's artifactId to these. -->
    <url>https://github.com/porelo-ai/porelo-planner/</url>

    <scm child.scm.url.inherit.append.path="false"
         child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false">
        <url>https://github.com/porelo-ai/porelo-planner/</url>
        <connection>scm:git:git://github.com/porelo-ai/porelo-planner.git</connection>
        <developerConnection>scm:git:git@github.com:porelo-ai/porelo-planner.git</developerConnection>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/porelo-ai/porelo-planner/issues</url>
    </issueManagement>

    <properties>
        <!-- Spring Boot, imported as a BOM: porelo-parent stays the one parent. -->
        <spring-boot.version>4.1.2</spring-boot.version>
        <!-- The command line 'exec:exec@machines' gives porelo-machines, such as 'jdk'. -->
        <machines.args></machines.args>
    </properties>

    <modules>
        <module>planner</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot's versions first, JUnit's among them: its test support is built against JUnit 6, so the
                 JUnit 5 set porelo-parent imports would break every Spring test. An import here comes before the
                 parent's. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>

        <plugins>

            <!-- The shared code style, from porelo-parent: google-java-format (AOSP) and shfmt, checked in validate.
                 'spotless:apply' formats; the formatting commit is in .git-blame-ignore-revs. -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>dev.logchange</groupId>
                <artifactId>logchange-maven-plugin</artifactId>
                <version>${logchange-maven-plugin.version}</version>
                <inherited>false</inherited>
                <executions>
                    <execution>
                        <id>logchange-lint</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>lint</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin.version}</version>
                <inherited>false</inherited>
                <executions>
                    <!-- Any porelo-machines command, in a JVM of its own: the pinned GraalVM for a CI job. -->
                    <execution>
                        <id>machines</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <includeProjectDependencies>false</includeProjectDependencies>
                            <includePluginDependencies>true</includePluginDependencies>
                            <executableDependency>
                                <groupId>org.fuin.porelo</groupId>
                                <artifactId>porelo-machines</artifactId>
                            </executableDependency>
                            <commandlineArgs>-classpath %classpath org.fuin.porelo.machines.Main ${machines.args}</commandlineArgs>
                        </configuration>
                    </execution>
                    <!-- Any other porelo-release command, in a JVM of its own: it exits with the command's code. -->
                    <execution>
                        <id>release</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <includeProjectDependencies>false</includeProjectDependencies>
                            <includePluginDependencies>true</includePluginDependencies>
                            <executableDependency>
                                <groupId>org.fuin.porelo</groupId>
                                <artifactId>porelo-release</artifactId>
                            </executableDependency>
                            <commandlineArgs>-classpath %classpath org.fuin.porelo.release.Main ${release.args}</commandlineArgs>
                        </configuration>
                    </execution>
                    <!-- A release depends only on releases: run on a tag, on the effective pom
                         'help:effective-pom -Doutput=target/effective-pom.xml' wrote. -->
                    <execution>
                        <id>check-releases</id>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <includeProjectDependencies>false</includeProjectDependencies>
                            <includePluginDependencies>true</includePluginDependencies>
                            <executableDependency>
                                <groupId>org.fuin.porelo</groupId>
                                <artifactId>porelo-release</artifactId>
                            </executableDependency>
                            <commandlineArgs>-classpath %classpath org.fuin.porelo.release.Main check-releases ${maven.multiModuleProjectDirectory}/target/effective-pom.xml --requires org.fuin.porelo:porelo-release</commandlineArgs>
                        </configuration>
                    </execution>
                    <!-- Every workflow step pinned by commit. -->
                    <execution>
                        <id>check-actions</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <includeProjectDependencies>false</includeProjectDependencies>
                            <includePluginDependencies>true</includePluginDependencies>
                            <executableDependency>
                                <groupId>org.fuin.porelo</groupId>
                                <artifactId>porelo-release</artifactId>
                            </executableDependency>
                            <commandlineArgs>-classpath %classpath org.fuin.porelo.release.Main check-actions ${maven.multiModuleProjectDirectory}/.github</commandlineArgs>
                        </configuration>
                    </execution>
                    <!-- The shared block of AGENTS.md carries the hash of its text, so a copy edited on its own fails. -->
                    <execution>
                        <id>check-shared</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <includeProjectDependencies>false</includeProjectDependencies>
                            <includePluginDependencies>true</includePluginDependencies>
                            <executableDependency>
                                <groupId>org.fuin.porelo</groupId>
                                <artifactId>porelo-release</artifactId>
                            </executableDependency>
                            <commandlineArgs>-classpath %classpath org.fuin.porelo.release.Main check-shared ${maven.multiModuleProjectDirectory}/AGENTS.md ${maven.multiModuleProjectDirectory}/.editorconfig</commandlineArgs>
                        </configuration>
                    </execution>
                    <!-- No file cites an issue in a way that goes stale once the issue is finished and deleted. -->
                    <execution>
                        <id>check-citations</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <includeProjectDependencies>false</includeProjectDependencies>
                            <includePluginDependencies>true</includePluginDependencies>
                            <executableDependency>
                                <groupId>org.fuin.porelo</groupId>
                                <artifactId>porelo-release</artifactId>
                            </executableDependency>
                            <commandlineArgs>-classpath %classpath org.fuin.porelo.release.Main check-citations ${maven.multiModuleProjectDirectory}</commandlineArgs>
                        </configuration>
                    </execution>
                    <!-- Every module has a README.md beside its pom.xml, linking its submodules. -->
                    <execution>
                        <id>check-readmes</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <includeProjectDependencies>false</includeProjectDependencies>
                            <includePluginDependencies>true</includePluginDependencies>
                            <executableDependency>
                                <groupId>org.fuin.porelo</groupId>
                                <artifactId>porelo-release</artifactId>
                            </executableDependency>
                            <commandlineArgs>-classpath %classpath org.fuin.porelo.release.Main check-readmes ${maven.multiModuleProjectDirectory}</commandlineArgs>
                        </configuration>
                    </execution>
                    <!-- Every page of doc/ is in mkdocs.yml's navigation once, and every link on it can be followed. -->
                    <execution>
                        <id>check-doc-site</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <includeProjectDependencies>false</includeProjectDependencies>
                            <includePluginDependencies>true</includePluginDependencies>
                            <executableDependency>
                                <groupId>org.fuin.porelo</groupId>
                                <artifactId>porelo-release</artifactId>
                            </executableDependency>
                            <commandlineArgs>-classpath %classpath org.fuin.porelo.release.Main check-doc-site ${maven.multiModuleProjectDirectory}/doc ${maven.multiModuleProjectDirectory}/mkdocs.yml</commandlineArgs>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>org.fuin.porelo</groupId>
                        <artifactId>porelo-machines</artifactId>
                        <version>${porelo.buildtools.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>org.fuin.porelo</groupId>
                        <artifactId>porelo-release</artifactId>
                        <version>${porelo.buildtools.version}</version>
                    </dependency>
                </dependencies>
            </plugin>

        </plugins>

    </build>

    <profiles>
        <profile>
            <!-- A change to documents or issues: only the tests that read them, tagged so. -->
            <id>documents</id>
            <properties>
                <groups>documents</groups>
            </properties>
        </profile>
    </profiles>

</project>
