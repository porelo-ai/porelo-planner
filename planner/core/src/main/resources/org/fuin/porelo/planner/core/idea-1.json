{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "idea-1.json",
  "title": "An idea discussed with a person: one story and an issue for each repository it concerns",
  "type": "object",
  "additionalProperties": false,
  "required": ["story", "issues"],
  "properties": {
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "gain", "test", "priority"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000-\\u001F\\u007F]+$", "description": "One line." },
        "gain": { "type": "string", "minLength": 1, "maxLength": 4000, "description": "What a user gains." },
        "test": { "type": "string", "minLength": 1, "maxLength": 4000, "description": "How a person sees it work." },
        "priority": { "enum": ["Highest", "High", "Medium", "Low", "Lowest"] }
      }
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository", "title", "mustBeTrue", "worker"],
        "properties": {
          "repository": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$", "description": "One of the project's repositories." },
          "title": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000-\\u001F\\u007F]+$", "description": "One line." },
          "mustBeTrue": { "type": "string", "minLength": 1, "maxLength": 4000, "description": "What must be true, from the point of view of whoever uses it." },
          "size": { "enum": ["XS", "S", "M", "L", "XL"], "description": "Only when it is known." },
          "worker": { "enum": ["Agent", "Manual"], "description": "Who works the issue, as the person chose it." }
        }
      }
    }
  }
}
